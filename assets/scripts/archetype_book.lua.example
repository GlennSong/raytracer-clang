-- THE ARCHETYPE BOOK — the architect's SELECTION layer as data.
--
-- Rename this file to archetype_book.lua (here for every level, or next to a
-- level's .json for just that level) and the city's per-district building mix
-- becomes YOURS: each district lists {recipe, weight} pairs, weights relative
-- (any scale), rolled once per lot. A district you omit keeps the architect's
-- compiled-in table. The style book (style_book.lua) restyles what stands;
-- THIS book decides what stands. Same recipe vocabulary in both — the
-- registry in architect.cpp (kRecipeRegistry) is the authoritative list.
--
-- RULES (all-or-nothing): an unknown recipe or district name, a weight <= 0,
-- or an empty district table REJECTS the whole book with a LOG_ERROR naming
-- the offender — never a silent skip, never half a book. Landmark lots
-- (capitol, courthouse, school...) are PLACED by the planner with quotas and
-- ignore this book: it governs the rolled fabric between the anchors.
--
-- The weights below are the compiled tables VERBATIM — activating this file
-- unchanged reproduces every city bit-for-bit (gated by
-- archetype_book_identity_weights_reproduce_the_ladders). Edit from here.
archetype_book = {
  financial = {
    {"glass_tower", 26}, {"podium_tower", 12}, {"office_slab", 17},
    {"art_deco_tower", 9}, {"stepped_tower", 9}, {"drum_tower", 7},
    {"commercial_block", 9}, {"parking_garage", 4.5}, {"plaza", 3.5},
    {"civic_hall", 3},
  },
  commercial = {
    {"pocket_park", 4}, {"plaza", 3}, {"brick_shop", 18}, {"mixed_use", 13},
    {"office_midrise", 8}, {"podium_tower", 3}, {"condo_tower", 6},
    {"terrace_condo", 6}, {"loft_block", 6}, {"hotel", 6}, {"bank", 5},
    {"cinema", 4}, {"strip_mall", 4}, {"supermarket", 4}, {"office_park", 3},
    {"pagoda_tower", 2}, {"civic_midtown", 3}, {"walkup_homes", 2},
  },
  oldtown = {
    {"oldtown_house", 62}, {"oldtown_cafe", 20}, {"oldtown_grand", 18},
  },
  industrial = {
    {"metal_shed", 45}, {"factory", 25}, {"brick_warehouse", 15},
    {"industrial_office", 15},
