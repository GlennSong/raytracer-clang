{
  "version": 1,
  "name": "Crosswalk Skew Lab",
  "_comment": "A wide arterial met by an OBLIQUE side street at ~29 deg, plus a perpendicular one for contrast. The skewed crosswalk must set back past the arterial's ribbon (mouth = hw/sin(theta)), not jut into the intersection.",
  "environment": { "skyColor": [0.55, 0.68, 0.86] },
  "entities": [
    { "name": "ground", "shape": "box", "position": [0, -0.3, 0], "size": [420, 0.4, 420],
      "material": { "albedo": [0.34, 0.42, 0.30], "roughness": 1.0 },
      "physics": { "motion": "static", "friction": 0.9 } },
    { "name": "streets", "shape": "road", "position": [0, 0, 0],
      "road": {
        "nodes": [
          { "x": -150, "z": 0 }, { "x": 0, "z": 0 }, { "x": 150, "z": 0 },
          { "x": 130, "z": 72 },
          { "x": -80, "z": 0 }, { "x": -80, "z": 90 }
        ],
        "edges": [ [0, 4, 15], [4, 1, 15], [1, 2, 15], [1, 3, 8], [4, 5, 8] ],
        "curved": false,
        "width": 15, "sidewalk": 4.0, "curb": 0.16, "corner_radius": 3.0,
        "lift": 0.25, "markings": true, "crosswalks": true, "auto_roundabout": false
      } }
  ],
  "lighting": {
    "sun": { "direction": [0.3, 0.85, -0.2], "color": [1.0, 1.0, 1.0], "intensity": 6.0, "castsShadow": true },
    "exposure": 0.7, "ambientMultiplier": 0.75
  }
}
