// through a float texture channel without a cast that varies by language.
const RL_MARK_NONE : i32 = 0;
const RL_MARK_SOLID : i32 = 1;
const RL_MARK_DASHED : i32 = 2;
const RL_MARK_DOUBLE : i32 = 3;
const RL_MARK_SOLID_DASHED : i32 = 4;
const RL_MARK_DASHED_SOLID : i32 = 5;
const RL_MARK_WIDE_DASHED : i32 = 6;
const RL_MARK_BOTTS : i32 = 7;
const RL_MARK_HATCH : i32 = 8;
const RL_MARK_CHEVRON : i32 = 9;
// Paint colours, as an index rather than a triple: three floats per boundary
// saved, and every backend already needs the same small palette.
const RL_PAINT_WHITE : i32 = 0;
const RL_PAINT_YELLOW : i32 = 1;
const RL_PAINT_RED : i32 = 2;
const RL_PAINT_BLUE : i32 = 3;
const RL_PAINT_GREEN : i32 = 4;

// Eight floats — two RGBA texels, or eight interpolated vertex channels.
struct RlBoundary {
  t         : f32,  // lateral offset from the reference line, IN METRES
  style     : f32,  // RL_MARK_*
  width     : f32,  // stripe width (m)
  gap       : f32,  // gap between the pair, for the double styles (m)
  dashOn    : f32,  // dash length (m)
  dashOff   : f32,  // gap length (m)
  wear      : f32,  // extra wear on this marking, over the road's own
  color     : f32,  // RL_PAINT_*
}

struct RlPaint {
  coverage  : f32,
  r         : f32,
  g         : f32,
  b         : f32,
}

struct RlRgb {
  r         : f32,
  g         : f32,
  b         : f32,
