    leaves = { size = 0.05, shoots = 6, shoot_length = 0.22, per_shoot = 1, angle = 50, fold = 12, curl = 0.2, droop = 0.3,
               face = 0.5, budget = 8000,
               blossom = { size = 0.035, per_cluster = 5, clusters = 5, cup = 0.35, budget = 32000 } },
    card = {
