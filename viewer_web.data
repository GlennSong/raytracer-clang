      joints = 1,
      droop = {0.18, 0.28}, light = {0.15, 0.25}, crookChance = {0.10, 0.20}, crookAngle = {12, 22},
      meander = {0.08, 0.12}, lean = {0, 5}, angleJitter = {8, 12},
