                  near_twig_tris = 14000,
                  params = { radiusScale = 5.5, droop = {0.12, 0.18}, flare = 1.1, rootSpread = 3.0, deadChance = 0.08,
                             trunkZoneTris = 3600, barkNoise = 0.07 } },
