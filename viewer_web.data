    { grid = { 1.6, 1.6 }, from = 0.15, aisle = { 0.2, 9.0 },
      set = {
        { pick = "desk_screen", x = 0.03 },
        { pick = { family = "surface", tags = { "office" } }, x = 0.8 },
        { pick = "monitor", x = 0.8, z = 0.12, y = 0.75 },
