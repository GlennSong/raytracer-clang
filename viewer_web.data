      mature  = { iterations = 62, vars = { whorls = {50, 56}, len = {0.58, 0.64}, reach = {1.3, 1.6} }, sprig = 2.2,
                  near_leaves = 20000, near_twig_tris = 11000, params = { radiusScale = 3.0, droop = {0.08, 0.14}, deadChance = 0.03,
