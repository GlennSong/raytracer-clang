#version 450
// THE SKY CUBEMAP'S ROUGH MIPS (ADR-0371): mip `level` of the sky cube is the GGX lobe of roughness level / (levels - 1)
// over mip 0 -- importance-sampled (Karis 2013, the split sum's first half; the BRDF LUT is the second), N = V = R.
// Samples read the source at a mip matched to their solid angle (filtered importance sampling), so 48 of them are smooth.
#include "cube_common.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly imageCube dst;
layout(set = 0, binding = 1) uniform samplerCube src;

layout(push_constant) uniform Push {
    vec4 params;   // x roughness, y the source's mip-0 size, z its mip count
} pc;

const float PI = 3.14159265;


void main() {
    ivec2 size = imageSize(dst).xy;
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (id.x >= size.x || id.y >= size.y) return;
    vec3 N = cubeDir(id.z, (vec2(id.xy) + 0.5) / vec2(size));
    float rough = max(pc.params.x, 0.02);
    float a = rough * rough, a2 = a * a;
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tx = normalize(cross(up, N)), ty = cross(N, tx);
    const uint COUNT = 48u;
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    float texelSolid = 4.0 * PI / (6.0 * pc.params.y * pc.params.y);
    for (uint i = 0u; i < COUNT; ++i) {
        vec2 xi = hammersley(i, COUNT);
        vec3 H = ggxHalfway(N, tx, ty, a2, xi);
        vec3 L = normalize(2.0 * dot(N, H) * H - N);
        float NdotL = dot(N, L);
        if (NdotL <= 0.0) continue;
        float NdotH = max(dot(N, H), 0.0);
        float d = (NdotH * NdotH * (a2 - 1.0) + 1.0);
        float D = a2 / (PI * d * d);
        float pdf = D * 0.25;   // D(H) NdotH / (4 VdotH), N = V
        float sampleSolid = 1.0 / (float(COUNT) * pdf + 1e-6);
        float mip = clamp(0.5 * log2(sampleSolid / texelSolid) + 1.0, 0.0, pc.params.z - 1.0);
        sum += textureLod(src, L, mip).rgb * NdotL;
        weight += NdotL;
    }
    vec3 c = sum / max(weight, 1e-4);
    imageStore(dst, id, vec4(any(isnan(c)) || any(isinf(c)) ? vec3(0.0) : c, 1.0));
}
