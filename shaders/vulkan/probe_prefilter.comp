#version 450
// A REFLECTION PROBE'S ROUGH MIPS (ADR-0373): mip `level` of the probe's radiance cube is the GGX lobe of its
// roughness over mip 0, the probe's own layer of the cube array. (sky_prefilter.comp's importance samples, but every one
// read from mip 0: the mips are written into the cube they read, through a view of mip 0 alone -- the sky's filtered
// sampling, a mip matched to each sample's solid angle, would need the lower mips readable as each is written.)
#include "cube_common.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2DArray dst;   // the mip being written
layout(set = 0, binding = 1) uniform samplerCubeArray src;                    // mip 0 read

layout(push_constant) uniform Push {
    vec4 params;   // x roughness, y the probe's index
} pc;

const float PI = 3.14159265;


void main() {
    ivec2 size = imageSize(dst).xy;
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (id.x >= size.x || id.y >= size.y) return;
    vec3 N = cubeDir(id.z, (vec2(id.xy) + 0.5) / vec2(size));
    float rough = max(pc.params.x, 0.02);
    float a = rough * rough, a2 = a * a;
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tx = normalize(cross(up, N)), ty = cross(N, tx);
    const uint COUNT = 48u;
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (uint i = 0u; i < COUNT; ++i) {
        vec2 xi = hammersley(i, COUNT);
        vec3 H = ggxHalfway(N, tx, ty, a2, xi);
        vec3 L = normalize(2.0 * dot(N, H) * H - N);
        float NdotL = dot(N, L);
        if (NdotL <= 0.0) continue;
        sum += textureLod(src, vec4(L, pc.params.y), 0.0).rgb * NdotL;
        weight += NdotL;
    }
    vec3 c = sum / max(weight, 1e-4);
    imageStore(dst, ivec3(id.xy, int(pc.params.y) * 6 + id.z), vec4(any(isnan(c)) || any(isinf(c)) ? vec3(0.0) : c, 1.0));
}
