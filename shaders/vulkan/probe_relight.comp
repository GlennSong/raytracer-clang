#version 450
#extension GL_GOOGLE_include_directive : require
// A REFLECTION PROBE RELIT (ADR-0373): every texel of its six captured faces (what the surface is: probe capture,
// ADR-0372) lit as the scene pass lights a surface -- the frame's lights (the sun or moon with its cascaded and
// mountain shadow, the picked lamps), the sky's light by the harmonics, its reflection of the sky cube, its own glow --
// or, where the capture found nothing, the sky itself. Into the probe's radiance cube, mip 0, in engine units.
#include "sky_common.glsl"
#include "globals.glsl"
#define SHADE_DIFFUSE_ONLY   // the highlights of the lights stay out of a probe (ADR-0374)
#include "lighting_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2DArray gAlbedo;   // rgb albedo, a metallic
layout(set = 1, binding = 1) uniform sampler2DArray gNormal;   // rgb normal * 0.5 + 0.5, a roughness
layout(set = 1, binding = 2) uniform sampler2DArray gEmit;     // rgb emission, a distance from the probe
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2DArray radiance;

layout(push_constant) uniform Push {
    vec4 eye;      // xyz the probe, w its index
} pc;

vec3 cubeDir(int face, vec2 uv) {
    vec2 p = uv * 2.0 - 1.0;
    if (face == 0) return normalize(vec3(1.0, -p.y, -p.x));
    if (face == 1) return normalize(vec3(-1.0, -p.y, p.x));
    if (face == 2) return normalize(vec3(p.x, 1.0, p.y));
    if (face == 3) return normalize(vec3(p.x, -1.0, -p.y));
    if (face == 4) return normalize(vec3(p.x, -p.y, 1.0));
    return normalize(vec3(-p.x, -p.y, -1.0));
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    ivec2 size = imageSize(radiance).xy;
    if (id.x >= size.x || id.y >= size.y) return;
    int layer = int(pc.eye.w) * 6 + id.z;
    vec4 alb = texelFetch(gAlbedo, ivec3(id.xy, layer), 0);
    vec4 nr = texelFetch(gNormal, ivec3(id.xy, layer), 0);
    vec4 em = texelFetch(gEmit, ivec3(id.xy, layer), 0);
    vec3 dir = cubeDir(id.z, (vec2(id.xy) + 0.5) / vec2(size));
    vec3 col;
    if (em.a > 9000.0) {
        col = skyIsPhysical() ? textureLod(skyCubeTex, dir, 0.0).rgb : mix(g.skyHorizon.rgb, g.skyZenith.rgb, clamp(dir.y, 0.0, 1.0));
    } else {
        // (a negative distance: an indoor surface, ADR-0380 -- lit as mesh.frag lights a room: no open sky)
        const bool indoorTexel = em.a < 0.0;
        vec3 P = pc.eye.xyz + dir * abs(em.a);
        vec3 N = normalize(nr.rgb * 2.0 - 1.0);
        vec3 V = -dir;
        vec3 albedo = alb.rgb;
        float metallic = clamp(alb.a, 0.0, 1.0);
        float roughness = clamp(nr.a, 0.04, 1.0);
        vec3 f0 = mix(vec3(0.04), albedo, metallic);
        float a = max(roughness * roughness, 0.002);
        float a2 = a * a;
        float NdotV = max(dot(N, V), 1e-4);
        // the sun's shadow where the frame's cascades reach (measured from the frame's camera), the mountains' beyond
        float viewDepth = -(g.view * vec4(P, 1.0)).z;
        float sv = g.counts.y > 0 ? computeShadow(P, N, viewDepth) : 1.0;
        if (g.counts.x > 0) sv *= terrainShadow(P, normalize(g.lights[0].directionInner.xyz));
        vec3 direct = vec3(0.0);
        for (int i = 0; i < min(g.counts.x, 32); ++i)
            direct += shadeLight(g.lights[i], P, N, V, albedo, metallic, f0, a2, NdotV, vec3(sv));
        vec3 F = fresnelSchlickRoughness(NdotV, f0, roughness);
        vec3 kd = (1.0 - F) * (1.0 - metallic);
        vec3 irr = skyIsPhysical() ? skyIrradianceSH(N) : g.skyHorizon.rgb * 0.5;
        vec3 spec = skyIsPhysical() ? textureLod(skyCubeTex, reflect(-V, N), roughness * 5.0).rgb : vec3(0.0);
        if (indoorTexel && skyIsPhysical()) {
            irr = vec3(dot(skyIrradianceSH(vec3(0.0, 1.0, 0.0)), vec3(0.2126, 0.7152, 0.0722)) * 0.30);
            spec = irr;
        }
        col = direct + kd * albedo * irr * g.ambient.rgb + spec * F + em.rgb;
    }
    imageStore(radiance, ivec3(id.xy, layer), vec4(max(col, vec3(0.0)), 1.0));
}
