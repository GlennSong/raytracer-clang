#version 450
// THE AERIAL PERSPECTIVE VOLUME (ADR-0370; Hillaire 2020's fourth table): for each of 32 x 32 screen tiles, the air
// marched from the camera out along the tile's ray, the in-scattered light and the transmittance stored at 32
// distances (quadratic, out to `far`). A surface reads its own distance from it, so a mountain gets exactly the haze of
// the air in front of it -- never the whole horizon's glow, which a uniform-air shortcut gave it at sunset. The same
// medium, phases, transmittance and multiple scattering as sky_view.comp.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image3D inscatterVol;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D transmitVol;
layout(set = 0, binding = 2) uniform sampler2D transLut;
layout(set = 0, binding = 3) uniform sampler2D msLut;

layout(push_constant) uniform Push {
    vec4 planet;     // x ground radius, y top radius, z camera height (m), w Mie g
    vec4 rayleigh;   // rgb scattering /m, w scale height
    vec4 mie;        // x scattering, y extinction /m, z scale height, w the volume's far distance (m)
    vec4 sun;        // xyz toward the active light, w its illuminance above the air (units)
    vec4 ozone;      // rgb absorption at the peak; w the air's density scale (RT_AERIAL)
    vec4 camRight;   // xyz the view's right, scaled by tan(fovX / 2)
    vec4 camUp;      // xyz the view's up, scaled by tan(fovY / 2)
    vec4 camFwd;     // xyz the view's forward
} pc;

const float PI = 3.14159265;

float distToTop(float r, float mu, float rt) {
    float d = r * r * (mu * mu - 1.0) + rt * rt;
    return max(-r * mu + sqrt(max(d, 0.0)), 0.0);
}
vec3 transmittance(float r, float mu) {
    float rg = pc.planet.x, rt = pc.planet.y;
    r = clamp(r, rg, rt);
    float horizonMu = -sqrt(max(1.0 - (rg * rg) / (r * r), 0.0));
    if (mu < horizonMu) return vec3(0.0);
    float H = sqrt(max(rt * rt - rg * rg, 0.0));
    float rho = sqrt(max(r * r - rg * rg, 0.0));
    float d = distToTop(r, mu, rt), dMin = rt - r, dMax = rho + H;
    return textureLod(transLut, vec2(clamp((d - dMin) / max(dMax - dMin, 1e-4), 0.0, 1.0), clamp(rho / max(H, 1e-4), 0.0, 1.0)), 0.0).rgb;
}
vec3 multiScatter(float r, float muS) {
    return textureLod(msLut, vec2(clamp(muS * 0.5 + 0.5, 0.0, 1.0), clamp((r - pc.planet.x) / (pc.planet.y - pc.planet.x), 0.0, 1.0)), 0.0).rgb;
}
float ozoneDensity(float h) { return max(0.0, 1.0 - abs(h - 25000.0) / 15000.0); }

void main() {
    ivec3 size = imageSize(inscatterVol);
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 ndc = (vec2(px) + 0.5) / vec2(size.xy) * 2.0 - 1.0;   // x right, y DOWN (screen rows run down)
    vec3 dir = normalize(pc.camFwd.xyz + pc.camRight.xyz * ndc.x - pc.camUp.xyz * ndc.y);
    float rg = pc.planet.x;
    vec3 x0 = vec3(0.0, rg + max(pc.planet.z, 0.5), 0.0);
    vec3 light = normalize(pc.sun.xyz);
    float nu = dot(dir, light);
    float phaseR = 3.0 / (16.0 * PI) * (1.0 + nu * nu);
    float g = pc.planet.w, g2 = g * g;
    float phaseM = 3.0 / (8.0 * PI) * ((1.0 - g2) * (1.0 + nu * nu)) / ((2.0 + g2) * pow(1.0 + g2 - 2.0 * g * nu, 1.5));
    float density = pc.ozone.w;
    vec3 T = vec3(1.0), L = vec3(0.0);
    float t0 = 0.0;
    const int SUB = 3;
    for (int s = 0; s < size.z; ++s) {
        float f = (float(s) + 1.0) / float(size.z);
        float t1 = pc.mie.w * f * f;   // quadratic: fine near, coarse far
        float ds = (t1 - t0) / float(SUB);
        for (int k = 0; k < SUB; ++k) {
            vec3 p = x0 + dir * (t0 + (float(k) + 0.5) * ds);
            float rp = length(p);
            float h = max(rp - rg, 0.0);
            vec3 sR = pc.rayleigh.rgb * exp(-h / pc.rayleigh.w) * density;
            float sM = pc.mie.x * exp(-h / pc.mie.z) * density;
            vec3 ext = max((pc.rayleigh.rgb * exp(-h / pc.rayleigh.w) + vec3(pc.mie.y * exp(-h / pc.mie.z))) * density +
                           pc.ozone.rgb * ozoneDensity(h), vec3(1e-12));
            float muS = dot(p / rp, light);
            vec3 S = (transmittance(rp, muS) * (sR * phaseR + vec3(sM) * phaseM) + (sR + vec3(sM)) * multiScatter(rp, muS)) * pc.sun.w;
            vec3 stepT = exp(-ext * ds);
            L += T * (S - S * stepT) / ext;
            T *= stepT;
        }
        t0 = t1;
        imageStore(inscatterVol, ivec3(px, s), vec4(L, 1.0));
        imageStore(transmitVol, ivec3(px, s), vec4(T, 1.0));
    }
}
