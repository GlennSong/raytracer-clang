#version 450
// GPU erosion bake, Vulkan (ADR-0122): thermal talus slumping, the last stage of the weather bake's opt-in
// water block (ADR-0126). One source, compiled once per kernel by CMake (-DKERNEL_THERMAL / _APPLY);
// dispatched in order by src/engine/procgen/erosion_gpu_vk.cpp. (ADR-0257 retired the droplet kernels that
// shared this file.)
//
// DETERMINISM: THERMAL reads the heightmap and WRITES fixed-point int32 deltas (scale 2^16) by atomic add --
// integer addition is order-free -- and APPLY folds them in, so a bake is bit-identical run to run.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Height  { float h[]; };
layout(std430, set = 0, binding = 1) buffer Delta   { int delta[]; };

// Mirrored by ErosionPushVk in erosion_gpu_vk.cpp (three four-byte scalars).
layout(push_constant) uniform U {
    int   n;
    float talus;
    float thermalRate;
} u;

const float kFixedScale = 65536.0;

// round() away from zero on .5 in GLSL is implementation-defined; roundEven is exact and symmetric,
// so +v/-v pairs still cancel in the integer domain
void scatterFixed(int x, int z, float v) {
    int fixedV = int(roundEven(v * kFixedScale));
    if (fixedV != 0) atomicAdd(delta[z * u.n + x], fixedV);
}

#ifdef KERNEL_THERMAL
void main() {
    int n = u.n;
    uint idxU = gl_GlobalInvocationID.x;
    if (idxU >= uint(n * n)) return;
    int idx = int(idxU), x = idx % n, z = idx / n;
    if (x < 1 || z < 1 || x >= n - 1 || z >= n - 1) return;
    float here = h[idx];
    int lx = x, lz = z; float lowest = here;
    const ivec2 off[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
    for (int i = 0; i < 4; i++) {
        float nh = h[(z + off[i].y) * n + (x + off[i].x)];
        if (nh < lowest) { lowest = nh; lx = x + off[i].x; lz = z + off[i].y; }
    }
    float drop = here - lowest;
    if (drop > u.talus) {
        float move = (drop - u.talus) * 0.5 * u.thermalRate;
        scatterFixed(x, z, -move);
        scatterFixed(lx, lz, move);
    }
}
#endif

#ifdef KERNEL_APPLY
void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= uint(u.n * u.n)) return;
    int d = atomicExchange(delta[tid], 0);
    if (d != 0) h[tid] += float(d) * (1.0 / kFixedScale);
}
#endif
