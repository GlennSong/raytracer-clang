#version 450
// THE SKY AS A CUBEMAP (ADR-0371): the physical sky's dome (the sky-view texture, sky_view.comp) drawn into the six faces
// of a cube, mip 0 -- the source sky_prefilter.comp blurs into the rough surfaces' mips. No sun disc: the sun is lit
// directly (and a mirror's highlight from it); taking it again through the reflections doubled it.
#include "cube_common.glsl"
#include "atmosphere_common.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly imageCube cube;
layout(set = 0, binding = 1) uniform sampler2D skyViewTex;

layout(push_constant) uniform Push {
    vec4 sun;      // xyz toward the active light (the sky view's reference), w 0
    vec4 planet;   // x ground radius, y camera height
} pc;



void main() {
    ivec2 size = imageSize(cube).xy;
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (id.x >= size.x || id.y >= size.y) return;
    vec3 dir = cubeDir(id.z, (vec2(id.xy) + 0.5) / vec2(size));
    // below the horizon the dome blends to the horizon's own light: distant land as haze
    vec3 col = atmSkyViewRadiance(skyViewTex, dir, pc.sun.xyz, pc.planet.x, pc.planet.y);
    imageStore(cube, id, vec4(col, 1.0));
}
