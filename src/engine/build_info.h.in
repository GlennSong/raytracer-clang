#ifndef RAYTRACER_ENGINE_BUILD_INFO_H
#define RAYTRACER_ENGINE_BUILD_INFO_H

// Generated by CMake from src/engine/build_info.h.in at configure time (so the git string is as fresh as
// the last configure). The engine's identity for logs, the `info` control verb and bundle manifests
// (ADR-0084). Content keys, not this string, decide whether a bundle is current.

#define RT_BUILD_GIT_DESCRIBE "@RT_GIT_DESCRIBE@"
#define RT_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define RT_BUILD_COMPILER "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@"
#define RT_BUILD_PLATFORM "@CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_PROCESSOR@"

#endif
